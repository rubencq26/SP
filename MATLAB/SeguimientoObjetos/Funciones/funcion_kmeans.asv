function esferas = funcion_kmeans(XCo, XFondo, N)
    
    XCol = double(XCo);

    nXCol = size(XCol,1);

    esferas = zeros(N, 4, 'double');

    for i = 1 : N
        color = 1 + (nXCol  - 1) * rand();
        color = int16(color);
        esferas(i, 1:3) = XCol(color, :);
    end

    esferasNuevas = zeros(N, 4, 'double');
    
    

    while esferasNuevas ~= esferas

        for i = 1 : N
            Index = zeros(nXCol, 2, 'uint8');
            for j = 1 : nXCol

                dist = sqrt((esferas(i, 1) - XCol(j, 1))^2 + (esferas(i, 2) -XCol(j,2) )^2 + (esferas(i, 3) - XCol(j, 3))^2 );

                if i == 1
                    Index(j,1) = 1;
                    Index(j,2) = dist;
                else
                    if dist < Index(j, 2)
                        Index(j, 1) = i;
                        Index(j, 2) = dist;
                    end

                end
            end

            Mb = Index(:,1) == i;

            stats = regionprops(XCol(Mb, :), 'Centroid');

            esferasNuevas(i, 1:3) = [stats.Centroid];


        end
        


    end


end